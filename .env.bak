# Локальная разработка: работает из коробки на SQLite без внешних сервисов.
# Для продакшена заполняем переменные ниже (подсказки в .env.example).

DJANGO_SECRET_KEY=local-dev-secret-change-me
DEBUG=True
ALLOWED_HOSTS=*

# ─── Подключение pgAdmin ──────────────────────────────────────────────────────
#   Host: 127.0.0.1   Port: 5432
#   User: user        Password: beauty
#   Database: beauty_market

# ─── База данных: PostgreSQL (локальный Homebrew) ───
DB_NAME=beauty_market
DB_USER=user
DB_PASSWORD=beauty
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis: пусто = InMemory channel layer + locmem кэш
REDIS_URL=

# CORS: домены фронтов через запятую (в DEBUG разрешено всё)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe: пусто = ManualProvider (оплата подтверждается вручную)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: SMTP Gmail для восстановления пароля
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=ryskulovaslan96@gmail.com
EMAIL_HOST_PASSWORD=wloj cser odne jfra
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ryskulovaslan96@gmail.com

# Ссылка на страницу сброса пароля на фронте (куда ведёт письмо)
PASSWORD_RESET_URL=https://example.com/reset-password

# PIN (6 цифр) для коммерческой аналитики — только у владельца
ANALYTICS_PASSWORD=926411

# Celery: пусто = memory:// (задачи выполняются синхронно)
CELERY_BROKER_URL=
