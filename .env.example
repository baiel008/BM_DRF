# ─── Django ───
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# ─── База данных (пусто = SQLite для локальной разработки) ───
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── WebSocket channel layer (пусто = InMemory для dev) ───
REDIS_URL=

# ─── CORS: домены фронтендов через запятую (в DEBUG разрешено всё) ───
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Stripe (карты онлайн; вебхук обязателен для подтверждения оплат) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (пусто = вывод в консоль) ───
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@beauty.kg
